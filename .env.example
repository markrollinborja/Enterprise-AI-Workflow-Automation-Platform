# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.

# --- App ---
APP_NAME="Meridian Flow"
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Database (matches docker-compose.yml's db service) ---
DATABASE_URL=postgresql+psycopg://meridian:meridian@db:5432/meridian_flow

# --- Workflow definitions --- see app/services/workflows/definition_loader.py
# Docker Compose sets this directly to /app/workflows (where the
# ./workflows volume is mounted) — not read from .env there. Leave this
# commented out unless running the backend outside Docker with a
# non-standard layout; uncommenting with a blank value would override the
# code's working repo-root default with an empty path.
# WORKFLOWS_DIR=/absolute/path/to/workflows

# --- Auth --- see docs/architecture/authentication.md
# Generate a real value with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-generate-a-real-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- AI --- see app/services/ai/service.py
# Optional, not required to run the app or the test suite (tests mock the
# OpenAI client entirely). Without a real key, the two ai_action steps
# (recommend_access, summarize_justification) fail gracefully and the
# workflows still complete — see AIExecution rows / step output_data for
# what happened. Set a real key to see actual recommendations. Low-cost
# model by default; verify current pricing before generating volume.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Explicit call timeout in seconds (Phase 13, reliability) — deliberately
# tight for this project's call shape, well under the SDK's own 600s
# default. See Settings.openai_timeout_seconds.
OPENAI_TIMEOUT_SECONDS=20

# --- MCP --- see docs/architecture/mcp-architecture.md
# Path suffix matters: FastMCP's streamable-http transport mounts the
# protocol endpoint at /mcp by default (see mcp_server/app/server.py).
MCP_SERVER_URL=http://mcp_server:8100/mcp
MCP_MOCK_MODE=true
# Explicit call timeout in seconds (Phase 13, reliability) — mcp_server is
# a same-Docker-network hop, so this is generous already. See
# Settings.mcp_call_timeout_seconds.
MCP_CALL_TIMEOUT_SECONDS=10

# --- External integrations --- all optional while MCP_MOCK_MODE=true
# see docs/architecture/integration-strategy.md
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_EMAIL=
SLACK_BOT_TOKEN=
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_CALENDAR_ID=primary

# --- Jira fulfillment-confirmation webhook --- see ADR-0010,
# api/routes/webhooks.py. The secret configured when registering a
# dynamic (REST-API-created) Jira Cloud webhook with a secret — Jira signs
# each delivery with HMAC-SHA256 over the raw body and sends it as
# X-Hub-Signature-256. Blank in mock-mode local dev (no real Jira webhook
# is registered against this system), which makes /webhooks/jira refuse
# every request with 401 rather than silently accept unsigned ones.
JIRA_WEBHOOK_SECRET=

# ===========================================================================
# V2 — enterprise identity, integration and support reliability
# ===========================================================================

# --- Logging (V2 Module 7 groundwork) ---
# "text" for a human watching `docker compose logs`, "json" for anything
# machine-read. The observability profile sets json; local dev defaults to
# text because JSON is unreadable in a terminal.
# See app/core/logging.py.
LOG_FORMAT=text

# --- Salesforce (V2 Module 2) ---
# Free Developer Edition org: https://developer.salesforce.com/signup
# Full setup walkthrough, including the External Client App and the
# client-credentials Run-As user: docs/architecture/salesforce.md
#
# Leave blank to run Salesforce connections in simulated mode. Blank is a
# supported state, not a broken one — a live connection with no credentials
# reports itself unhealthy with a clear reason rather than crashing, and the
# platform never silently falls back to the simulator (ADR-0016).
#
# NOTE the instance URL uses .my.salesforce.com, NOT the .lightning.force.com
# domain you see in the browser. The Lightning URL returns redirects rather
# than a clean error, which is a confusing first hour.
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# No SALESFORCE_API_VERSION on purpose — the adapter discovers the newest
# version from /services/data/. Salesforce ships three releases a year and a
# pinned version rots into a 404 on a URL that looks correct.

# --- Authentication mode (V2 Module 4, ADR-0015) ---
# "local"  = V1's self-issued JWT. What the test suite uses; needs only
#            PostgreSQL. Refused at startup unless ENVIRONMENT is
#            local/test/ci, so it cannot be reached by accident anywhere
#            that matters.
# "oidc"   = real authorization-code flow against Keycloak.
# Both resolve to the same authorization layer; tests assert they reach
# identical RBAC decisions.
AUTH_MODE=local

# --- Keycloak OIDC (V2 Module 4) ---
# Start Keycloak with:  docker compose --profile identity up -d
# Admin console: http://localhost:8080  (KEYCLOAK_ADMIN / KEYCLOAK_ADMIN_PASSWORD)
#
# The issuer must match the token's `iss` claim EXACTLY, including scheme,
# host and port. A token obtained via localhost:8080 and one obtained via
# keycloak:8080 carry different issuers and only one will validate.
OIDC_ISSUER=http://localhost:8080/realms/meridian
# Leave unset here. docker-compose.yml sets this to
# http://keycloak:8080/realms/meridian/protocol/openid-connect/certs for
# the backend service specifically — the backend container can't reach
# Keycloak via "localhost" (that resolves to the container itself), but
# OIDC_ISSUER above has to stay the localhost URL because it must exactly
# match every token's iss claim. Only relevant if you're running the
# backend outside Docker against a dockerized Keycloak; see
# Settings.oidc_jwks_uri.
# OIDC_JWKS_URI=
OIDC_CLIENT_ID=meridian-flow
# No OIDC_CLIENT_SECRET: meridian-flow is a public client (ADR-0019). The
# frontend does the code-for-token exchange directly against Keycloak using
# PKCE — a secret shipped to every browser that loads the page wouldn't be
# confidential, so the backend never holds one.
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
OIDC_AUDIENCE=meridian-flow
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Microsoft Graph (V2 Module 6) --- see docs/architecture/microsoft-graph.md
# App-only (client-credentials) Entra ID app registration, granted
# User.ReadWrite.All application permission with admin consent. Free tenant:
# https://developer.microsoft.com/microsoft-365/dev-program
#
# Leave blank to run provision_m365_account in mock mode — same rule as
# every other mcp_server tool (MCP_MOCK_MODE below), blank credentials are
# a supported state, not a broken one.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- SCIM provisioning (V2 Module 5) ---
# Static bearer token presented by the provisioning client. Its own
# credential, revocable without disturbing any other integration — a SCIM
# client can create and deactivate accounts.
# Blank rejects every SCIM request; it never means "authentication disabled".
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SCIM_BEARER_TOKEN=

# --- n8n (V2 Module 3) ---
# Shared secret for HMAC-SHA256 over the raw body of POST /inbound/events.
# The same value must reach n8n (docker-compose passes it through as
# MERIDIAN_WEBHOOK_SECRET) and the backend. If they diverge every delivery
# gets a 401 — immediate and obvious, which is the intent.
#
# Blank is treated as a verification FAILURE, never as "verification
# disabled": a deployment that forgot to set this must reject traffic rather
# than quietly accept unauthenticated requests.
#
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
N8N_WEBHOOK_SECRET=
N8N_BASE_URL=http://n8n:5678
# No basic-auth variables: n8n removed basic auth in v1.0 and made user
# management mandatory, so N8N_BASIC_AUTH_* is silently ignored on 1.x.
# On first visit, http://localhost:5678 prompts you to create an instance
# owner account, which is stored in the n8n_data Docker volume and survives
# restarts. It is a local account, not an external service signup.
