# Claude Code: settings.json is shared project config and IS committed —
# it defines the permission allowlist and the destructive-command denylist
# every contributor should get. settings.local.json is the per-user file
# where Claude Code records personal "don't ask again" approvals, so it is
# machine-specific and must not be.
.claude/settings.local.json

# Logs
*.log

# Secrets / credentials (defense in depth beyond .env)
*.pem
*.key
credentials.json
service-account*.json

# Personal / not for public repo (resume prep material, private notes, etc.)
personal/
